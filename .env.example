# Vite exposes only vars prefixed with VITE_
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use the “anon” / “public” JWT key, or the publishable key shown in newer dashboards
VITE_SUPABASE_ANON_KEY=your_key_here

# Optional: if you only have a publishable key variable name from docs, use this instead:
# VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...

# Comma-separated emails that see profit / KPI dashboards (CEO role).
# Everyone else who signs in is Ops / Productions (daily brief, no money numbers).
VITE_CEO_EMAILS=you@company.com

# Railway (or local) FastAPI base URL
# VITE_API_BASE_URL=https://fgg-dash-production.up.railway.app

# Local Vite only: skip sign-in for UI preview (never applies to production builds).
# VITE_DEV_AUTH_BYPASS=0
