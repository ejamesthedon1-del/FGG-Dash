# Copy to .env and fill in (never commit .env)
SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_rotated_client_secret_here
SHOPIFY_API_VERSION=2026-04

# Optional second store: Sinners Testimony
SHOPIFY_SINNERS_STORE_DOMAIN=
SHOPIFY_SINNERS_CLIENT_ID=
SHOPIFY_SINNERS_CLIENT_SECRET=

# Optional: Facebook / Meta Ads (Marketing API) — Liv Don
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v22.0

# Optional: Meta Ads for Sinners Testimony
META_SINNERS_ACCESS_TOKEN=
META_SINNERS_AD_ACCOUNT_ID=

# Optional: Slack Incoming Webhook (ops order alerts)
SLACK_WEBHOOK_URL=

# Optional: comma-separated origins for browser dashboard (e.g. Vite dev server)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
