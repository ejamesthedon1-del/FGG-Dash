# Copy to .env and fill in (never commit .env)
SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_rotated_client_secret_here
SHOPIFY_API_VERSION=2026-04
# Order Flow risk Deny cancels orders via Admin API — app needs write_orders
# (plus existing read_orders). Reinstall/reconnect after adding the scope.

# Optional second store: Sinners Testimony
SHOPIFY_SINNERS_STORE_DOMAIN=
SHOPIFY_SINNERS_CLIENT_ID=
SHOPIFY_SINNERS_CLIENT_SECRET=

# Optional: Facebook / Meta Ads (Marketing API) — Livdon
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v22.0

# Optional: Meta Ads for Sinners Testimony
META_SINNERS_ACCESS_TOKEN=
META_SINNERS_AD_ACCOUNT_ID=

# Optional: Slack Incoming Webhook (ops order alerts)
SLACK_WEBHOOK_URL=

# Optional: fal.ai API key for CEO Mockups (FLUX Kontext)
# https://fal.ai/dashboard/keys
FAL_KEY=

# Durable Order Flow stages — set these on Railway for indefinite, all-device persistence.
# Create the table with supabase/migrations/002_order_flow_stages.sql first.
# Use Project Settings → API → Project URL + service_role secret (never expose to the browser).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here

# Optional: comma-separated origins for browser dashboard (e.g. Vite + Vercel)
# Example: https://your-app.vercel.app,http://127.0.0.1:5173,http://localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Frontend (Vercel): set VITE_API_BASE_URL=https://your-service.up.railway.app
# (no trailing slash). Leave unset for local Vite proxy.

# Optional: Gmail OAuth for Support inbox (Google Cloud OAuth Web client)
# Enable Gmail API; add test user; redirect must match the client exactly.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/support/gmail/callback
GMAIL_PROJECT_ID=
# Prefer business inbox on Connect (optional — leave blank so Google always shows account chooser)
# GMAIL_LOGIN_HINT=ejames@futuregarmentgroup.com
# GMAIL_HOSTED_DOMAIN=futuregarmentgroup.com
# Browser app URL after OAuth (defaults to first CORS origin)
FRONTEND_ORIGIN=http://localhost:5173

# Support auto-replies: leave false/unset while testing. Set true only when ready
# to email real customers on order-status asks.
# SUPPORT_AUTO_REPLY_LIVE=false
