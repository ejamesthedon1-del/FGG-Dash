# Copy to .env and fill in (never commit .env)
SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_rotated_client_secret_here
SHOPIFY_API_VERSION=2026-04

# Optional second store: Sinners Testimony
SHOPIFY_SINNERS_STORE_DOMAIN=
SHOPIFY_SINNERS_CLIENT_ID=
SHOPIFY_SINNERS_CLIENT_SECRET=

# Optional: Facebook / Meta Ads (Marketing API) — Livdon
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v22.0

# Optional: Meta Ads for Sinners Testimony
META_SINNERS_ACCESS_TOKEN=
META_SINNERS_AD_ACCOUNT_ID=

# Optional: Slack Incoming Webhook (ops order alerts)
SLACK_WEBHOOK_URL=

# Durable Order Flow stages — set these on Railway for indefinite, all-device persistence.
# Create the table with supabase/migrations/002_order_flow_stages.sql first.
# Use Project Settings → API → Project URL + service_role secret (never expose to the browser).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here

# Optional: comma-separated origins for browser dashboard (e.g. Vite + Vercel)
# Example: https://your-app.vercel.app,http://127.0.0.1:5173,http://localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Frontend (Vercel): set VITE_API_BASE_URL=https://your-service.up.railway.app
# (no trailing slash). Leave unset for local Vite proxy.
